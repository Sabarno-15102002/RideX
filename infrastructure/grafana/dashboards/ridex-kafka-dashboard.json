        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "Consumer Lag by Service",
          "description": "Total non-negative Kafka consumer lag grouped by RideX consumer group.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "type": "prometheus",
                        "uid": "PBFA97CFB590B2093"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "sum by (consumergroup) (kafka_consumergroup_lag{consumergroup!=\"ridex-lag-test-group\"} >= 0)",
                        "legendFormat": "{{consumergroup}}",
                        "range": true
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
