      "panel-1": {
        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "Cache Hit Ratio",
          "description": "Percentage of profile cache reads that are hits over the selected time range.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "type": "prometheus",
                        "uid": "PBFA97CFB590B2093"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "100 * sum(increase(cache_gets_total{cache=\"riderProfile\",result=\"hit\",job=\"rider-service\"}[$__range])) / clamp_min(sum(increase(cache_gets_total{cache=\"riderProfile\",result=~\"hit|miss\",job=\"rider-service\"}[$__range])), 1)",
                        "legendFormat": "__auto",
                        "range": false
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "13.2.3",
            "spec": {
              "options": {
                "colorMode": "value",
                "graphMode": "area",
                "justifyMode": "auto",
                "orientation": "auto",
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "",
                  "values": false
                },
                "textMode": "auto"
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "percent",
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": 0,
                        "color": "green"
                      },
                      {
                        "value": 80,
                        "color": "red"
                      }
                    ]
                  },
                  "color": {
                    "mode": "palette-classic",
                    "seriesBy": "max"
                  },
                  "min": 0,
                  "max": 100
                },
                "overrides": []
              }
            }
          }
        }
      },
